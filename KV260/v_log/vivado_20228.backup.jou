open_bd_design {R:/KV260/vivado/KV260.srcs/sources_1/bd/kv260_video/kv260_video.bd}
set rx0 [get_bd_cells /PS_VIDEO/RX_VIDEO/mipi_csi2_rx_subsyst_0]
puts "RX0 line rate = [get_property CONFIG.DPY_LINE_RATE $rx0] Mb/s"
