export_simulation -of_objects [get_files R:/KV260/vivado/KV260.srcs/sources_1/bd/kv260_video/kv260_video.bd] -directory R:/KV260/vivado/KV260.ip_user_files/sim_scripts -ip_user_files_dir R:/KV260/vivado/KV260.ip_user_files -ipstatic_source_dir R:/KV260/vivado/KV260.ip_user_files/ipstatic -lib_map_path [list {modelsim=R:/KV260/vivado/KV260.cache/compile_simlib/modelsim} {questa=R:/KV260/vivado/KV260.cache/compile_simlib/questa} {riviera=R:/KV260/vivado/KV260.cache/compile_simlib/riviera} {activehdl=R:/KV260/vivado/KV260.cache/compile_simlib/activehdl}] -use_ip_compiled_libs -force -quiet
