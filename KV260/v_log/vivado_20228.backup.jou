set_property -dict [list CONFIG.C_HS_LINE_RATE {900} CONFIG.DPY_LINE_RATE {900} CONFIG.C_EN_CNTS_BYTE_CLK {false} CONFIG.C_HS_SETTLE_NS {146}] [get_bd_cells PS_VIDEO/RX_VIDEO/mipi_csi2_rx_subsyst_0]
endgroup
set rx0 [get_bd_cells /PS_VIDEO/RX_VIDEO/mipi_csi2_rx_subsyst_0]
