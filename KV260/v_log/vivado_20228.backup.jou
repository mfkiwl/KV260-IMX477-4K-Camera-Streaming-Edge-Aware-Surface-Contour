validate_bd_design
save_bd_design
foreach p {C_RCVE_DESKEW_SEQ C_HS_LINE_RATE DPY_LINE_RATE} {
    puts "$p = [get_property CONFIG.$p $rx0]"
}
launch_runs synth_1 -jobs 8
wait_on_run synth_1
close_design
close_design
report_ip_status -name ip_status 
open_run synth_1 -name synth_1
source {R:/KV260/block_design/check_contour_synthesis.tcl}
set buf [get_cells -hier -filter {NAME =~ */mipi_csi2_rx_subsyst_0/*pll0_clkout1_buf}]
if {[llength $buf] == 1} {
    set pin [get_pins -of_objects $buf -filter {REF_PIN_NAME == O}]
    set loads [all_fanout -flat -endpoints_only -from $pin]
    puts "RX0 CLKOUT1 buffer: $buf"
    puts "Endpoint count: [llength $loads]"
    foreach load [lrange $loads 0 19] {puts $load}
} else {
    puts "Expected one RX0 buffer. Matched: $buf"
}
foreach rx {0 1} {
    set pattern "*/mipi_csi2_rx_subsyst_${rx}/*pll0_clkout1_buf"
    set buf [get_cells -quiet -hier -filter "NAME =~ $pattern"]
    if {[llength $buf] != 1} {
        puts "RX${rx}: matched [llength $buf] buffers"
        continue
    }

    set pin [get_pins -of_objects $buf -filter {REF_PIN_NAME == O}]
    set nets [get_nets -quiet -segments -of_objects $pin]
    if {![llength $nets]} {
        puts "RX${rx}: buffer O has no connected net"
        continue
    }

    set loads [get_pins -quiet -leaf -of_objects $nets -filter {DIRECTION != OUT}]
    set ports [get_ports -quiet -of_objects $nets -filter {DIRECTION != IN}]
    puts "RX${rx}: [llength $loads] load pins, [llength $ports] output ports"
    foreach obj [concat $loads $ports] {puts "  $obj"}
}
opt_design -sweep
puts "Remaining CLKOUT1 buffers: [get_cells -quiet -hier -filter {NAME =~ */pll0_clkout1_buf}]"
set out [get_property DIRECTORY [get_runs synth_1]]
report_pulse_width -file [file join $out contour_after_sweep_pulse_width.rpt]
set out [get_property DIRECTORY [get_runs synth_1]]
report_timing_summary -delay_type min_max -report_unconstrained -max_paths 20 \
    -file [file join $out contour_after_sweep_timing_summary.rpt]
save_constraints
reset_run synth_1
launch_runs impl_1 -jobs 8
wait_on_run impl_1
close_design
close_design
launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
write_hw_platform -fixed -include_bit -force -file R:/KV260/vitis/kv260_video_wrapper.xsa
open_run impl_1
set out [get_property DIRECTORY [get_runs impl_1]]
report_timing_summary -delay_type min_max -report_unconstrained -max_paths 20 \
    -file [file join $out contour_post_route_timing_summary.rpt]
close_design
update_ip_catalog -rebuild -scan_changes
report_ip_status -name ip_status
upgrade_ip -vlnv xilinx.com:user:vfp:2.0 [get_ips  kv260_video_vfp_0_0] -log ip_upgrade.log
export_ip_user_files -of_objects [get_ips kv260_video_vfp_0_0] -no_script -sync -force -quiet
